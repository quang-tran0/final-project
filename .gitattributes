# ------------------------------------------------------------------
# Default text handling
# ------------------------------------------------------------------

* text=auto

# ------------------------------------------------------------------
# HDL source
# ------------------------------------------------------------------

*.sv      text eol=lf
*.svh     text eol=lf
*.v       text eol=lf
*.vh      text eol=lf

# ------------------------------------------------------------------
# Source / scripts
# ------------------------------------------------------------------

*.c       text eol=lf
*.h       text eol=lf
*.cpp     text eol=lf
*.hpp     text eol=lf
*.S       text eol=lf
*.s       text eol=lf

*.py      text eol=lf
*.sh      text eol=lf
*.tcl     text eol=lf

# ------------------------------------------------------------------
# Build / configuration
# ------------------------------------------------------------------

Makefile  text eol=lf
*.mk      text eol=lf
*.f       text eol=lf
*.vlt     text eol=lf

*.yaml    text eol=lf
*.yml     text eol=lf
*.toml    text eol=lf
*.json    text eol=lf

*.md      text eol=lf

# ------------------------------------------------------------------
# Binary files
# ------------------------------------------------------------------

*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary

*.zip     binary
*.tar     binary
*.gz      binary